# ============================================================================
# 前端环境变量模板：复制成 .env.local 后填写自己的值
# .env.local 已被 .gitignore 排除，不要提交真实密钥
# 注意：Vite 只会注入 VITE_ 前缀的变量
# ============================================================================

# 后端 API 地址
VITE_API_BASE_URL=http://127.0.0.1:8000

# AI 问答（OpenAI 兼容接口）—— 留空则 AI 问答页提示「API Key未配置」
VITE_AI_API_KEY=
VITE_AI_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_AI_MODEL=qwen3-max-preview
