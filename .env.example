# ============================================================================
# 复制成 .env 后填写自己的值 —— .env 不要提交到 Git（已加入 .gitignore）
# 本项目用 config/llm_conf.py 里的极简解析器读取，不依赖 python-dotenv
# ============================================================================

# ---------- 大模型（OpenAI 兼容接口）----------
# 不填也能启动：AI 摘要会自动降级为"原文摘录"，接口返回 degraded=true，不会 500
LLM_API_KEY=
# 常见服务商：
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   阿里云百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 超时（秒）：连接超时与整体读取超时分开设置
LLM_CONNECT_TIMEOUT=5
LLM_TIMEOUT=30
# 失败重试次数（只对 5xx / 网络错误重试；4xx 不重试，避免白烧额度）
LLM_MAX_RETRY=1

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=400
# 送入模型的正文截断长度（控制单次调用成本）
LLM_MAX_INPUT_CHARS=4000

# ---------- 摘要缓存 ----------
# 缓存 key 版本号：改了提示词或换了模型就把它 +1，可让旧摘要整体失效
SUMMARY_CACHE_VERSION=v1
# 摘要缓存有效期（秒），默认 7 天
SUMMARY_CACHE_EXPIRE=604800
# 降级摘要的缓存时间（秒）：短一些，等大模型恢复后能尽快拿到真正的摘要
SUMMARY_DEGRADED_CACHE_EXPIRE=600

# ---------- 批量任务 ----------
SUMMARY_BATCH_CONCURRENCY=3
SUMMARY_BATCH_MAX_ITEMS=30
SUMMARY_TASK_EXPIRE=3600
